generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { USER ADMIN }
enum ListingStatus { ACTIVE PENDING SOLD REJECTED }
enum SubscriptionStatus { FREE ACTIVE PAST_DUE CANCELED }

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  bio          String?
  role         Role @default(USER)
  verified     Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  listings     Listing[]
  favorites    Favorite[]
  sentMessages Message[] @relation("sent")
  receivedMessages Message[] @relation("received")
  subscriptions Subscription[]
}

model Category {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  createdAt DateTime @default(now())
  listings  Listing[]
}

model Listing {
  id          String @id @default(cuid())
  title       String
  description String
  price       Float
  currency    String @default("PKR")
  location    String
  condition   String?
  status      ListingStatus @default(PENDING)
  featured    Boolean @default(false)
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sellerId    String
  seller      User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  favorites   Favorite[]
  messages    Message[]
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([sellerId])
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  listingId String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, listingId])
}

model Message {
  id         String @id @default(cuid())
  body       String
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  listingId  String?
  sender     User @relation("sent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("received", fields: [receiverId], references: [id], onDelete: Cascade)
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  @@index([senderId, receiverId, createdAt])
}

model Subscription {
  id                   String @id @default(cuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  plan                 String
  status               SubscriptionStatus @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
